<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.osgi</groupId>
		<artifactId>org.osgi.framework.reactor</artifactId>
		<version>${revision}</version>
	</parent>
	<groupId>org.osgi.tck</groupId>
	<artifactId>org.osgi.tck.framework</artifactId>
	<packaging>pom</packaging>

	<!-- The versions of the TCK test runtime and of the framework under test,
	     in one place. The names are the ones org.osgi.maven.pom.parent
	     defines, so its dependencyManagement follows them too, and the
	     tck.bndrun files read the same properties: a bump here (by hand or
	     by Dependabot) changes the poms and the runs together. -->
	<properties>
		<junit-jupiter.version>5.12.2</junit-jupiter.version>
		<junit-platform.version>1.12.2</junit-platform.version>
		<opentest4j.version>1.3.0</opentest4j.version>
		<assertj.version>3.27.7</assertj.version>
		<hamcrest.version>2.2</hamcrest.version>
		<awaitility.version>4.2.0</awaitility.version>
		<servicemix-junit.version>4.13.2_1</servicemix-junit.version>
		<mockito.version>5.24.0</mockito.version>
		<byte-buddy.version>1.18.14</byte-buddy.version>
		<objenesis.version>3.2</objenesis.version>
		<osgi-test.version>1.3.0</osgi-test.version>
		<equinox.version>3.24.300</equinox.version>
		<osgi-tck-support.version>0.0.1-SNAPSHOT</osgi-tck-support.version>
		<maven-surefire-report-plugin.version>3.6.0</maven-surefire-report-plugin.version>
		<org.osgi.resource.version>1.0.1</org.osgi.resource.version>
	</properties>
	<modules>
		<module>org.osgi.test.cases.framework</module>
		<module>org.osgi.test.cases.framework.launch</module>
		<module>org.osgi.test.cases.framework.secure</module>
		<module>org.osgi.test.cases.framework.launch.secure</module>
		<module>org.osgi.test.run.framework.equinox</module>
		<module>org.osgi.test.run.framework.secure.equinox</module>
		<module>org.osgi.test.run.framework.launch.equinox</module>
		<module>org.osgi.test.run.framework.launch.secure.equinox</module>
	</modules>

</project>
